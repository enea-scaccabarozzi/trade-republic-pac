{
    "name": "Trade Republic PAC",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "features": {
        "ghcr.io/astral-sh/uv-devcontainer-features/uv:1": {},
        "ghcr.io/casey/just-devcontainer-feature/just:1": {}
    },
    "postCreateCommand": "uv sync && just hooks-install",
    "forwardPorts": [
        8080
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "ms-python.mypy-type-checker"
            ],
            "settings": {
                "python.defaultInterpreterPath": ".venv/bin/python"
            }
        }
    }
}