# Trade Republic credentials
PAC_TR_PHONE_NUMBER=+49XXXXXXXXXX
PAC_TR_PIN=XXXX
PAC_TR_COOKIES_PATH=/tmp/tr_cookies

# Telegram
PAC_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
PAC_TELEGRAM_CHAT_ID=123456789

# Webhook & job auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
PAC_WEBHOOK_URL=https://your-service.example.com/webhook
PAC_WEBHOOK_SECRET=your-webhook-secret-here
PAC_JOB_SECRET=your-job-secret-here

# Target allocation (must sum to 100)
PAC_TARGET_STOCKS_PCT=70
PAC_TARGET_GOLD_PCT=15
PAC_TARGET_BONDS_PCT=15

# Asset ISINs
PAC_ISIN_STOCKS=IE00BK5BQT80
PAC_ISIN_GOLD=IE00B4ND3602
PAC_ISIN_BONDS=IE00B3F81409

# Deviation thresholds
PAC_DEVIATION_WARNING_PCT=3.0
PAC_DEVIATION_CRITICAL_PCT=5.0
PAC_CYCLE_INVERSION_MIN_PCT=2.0

# PAC settings
PAC_PAC_MONTHLY_BUDGET=500.00
PAC_PAC_DAY_OF_MONTH=14

# Development mode (pretty logs instead of JSON)
# PAC_DEV=1
